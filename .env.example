# Redis for shared room state (required on Vercel; empty = in-memory store). KV_URL or UPSTASH_REDIS_URL also work. e.g. redis://default:<password>@<host>:6379
REDIS_URL=
# Comma-separated origins allowed to connect, `*` wildcards allowed (empty = allow all).
ALLOWED_ORIGIN=http://localhost:3000,https://*.vercel.app
# Local / self-hosted listen port (default 4000).
PORT=4000
# Local / self-hosted listen address (default 0.0.0.0).
HOST=0.0.0.0

# --- docker-compose.yml (self-hosted: be_game + Redis + Caddy) ---
# Public domain of this server, DNS pointing at the host (Caddy gets the HTTPS cert for it). e.g. game.example.com
GAME_DOMAIN=
# For compose, ALLOWED_ORIGIN above is passed to be_game; use your portfolio origin, e.g. https://example.com
# (REDIS_URL is set by compose itself to the bundled Redis.)
