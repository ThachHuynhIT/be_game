# Values per environment (local / self-hosted / Vercel): docs/DEPLOYMENT.md → "Biến môi trường theo nơi chạy".

# Redis for shared room state (required on Vercel; empty = in-memory store). KV_URL or UPSTASH_REDIS_URL also work. e.g. redis://default:<password>@<host>:6379
# REDIS_URL=rediss://default:<password>@<host>.upstash.io:6379  # self-host only AFTER the shared-store cutover (not done yet; docs/SELF_HOSTING.md). Secret: never commit it
REDIS_URL=
# Comma-separated origins allowed to connect, `*` matches [a-z0-9-.]+ (empty = allow all).
# Scope preview patterns to your project + team, never https://*.vercel.app (anyone can create one). The frontend is the zonenop-game repo, e.g.
#   https://play.fudio101.com,https://zonenop-game.vercel.app,https://zonenop-game-*-thachs-projects-48e5eaf9.vercel.app,http://localhost:3000
ALLOWED_ORIGIN=http://localhost:3000
# Local / self-hosted listen port (default 4000).
PORT=4000
# Local / self-hosted listen address (default 0.0.0.0).
HOST=0.0.0.0

# --- Accounts (docs/DEPLOYMENT.md -> "Biến môi trường theo nơi chạy") ---
# Postgres (Neon, pooled string) for accounts, results and page views. SECRET: never commit/log/print it.
# Empty = accounts in memory (lost on restart, one list per machine): dev only. e.g. postgres://<user>:<password>@<host>/<db>?sslmode=require
DATABASE_URL=
# Signs session tokens (HMAC). SECRET; 32+ random bytes: `openssl rand -base64 32`. Required in production (NODE_ENV=production or VERCEL),
# otherwise /api/auth/*, /api/admin/*, /api/track answer 503. Empty in dev/test = fixed insecure secret.
SESSION_SECRET=
# Comma-separated usernames that become admin when they REGISTER (register your own account first). Not secret.
ADMIN_USERNAMES=

# --- Compose files ---
# BE_GAME_COUNT_COMMANDS=1  # self-host: log the Redis command count every 60 s (see docs/SELF_HOSTING.md)
# BUILD_COMMIT is set by the deploy workflow (not here); /api/health reports it as `commit` (Vercel: VERCEL_GIT_COMMIT_SHA).
# compose.selfhost.yml passes REDIS_URL above to be_game; if it is empty or unset it uses the bundled Redis (redis://redis:6379).
# docker-compose.yml (VPS template) always uses its bundled Redis.
# Public domain of this server. Required by both:
#   docker-compose.yml   (VPS template: Caddy gets the HTTPS cert, DNS must point at the host)
#   compose.selfhost.yml (live server: Traefik routes this host name to be_game; see docs/SELF_HOSTING.md)
GAME_DOMAIN=
# ALLOWED_ORIGIN above is passed to be_game by both compose files.
