{
  "compilerOptions": {
    "target": "ES2022",
    // Vercel compiles api/*.ts with this config; CommonJS output lets the
    // extensionless relative imports resolve (ESM output would need ".js").
    "module": "CommonJS",
    "moduleResolution": "node",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "noEmit": true,
    "types": ["node"]
  },
  "include": ["api", "src", "test"]
}
