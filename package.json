{
  "name": "be_game",
  "version": "1.0.0",
  "private": true,
  "description": "Multiplayer game backend (Tiến Lên, Mèo Nổ, Cờ Tỷ Phú, Đá Quý, Đấu Súng): WebSocket server on Vercel Functions (or any Node host), rooms in Redis",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/local.ts",
    "start": "tsx src/local.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@vercel/functions": "^3.9.9",
    "ioredis": "^5.11.1",
    "pg": "^8.23.1",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/ws": "^8.18.1",
    "ioredis-mock": "^8.13.1",
    "pg-mem": "^3.0.14",
    "tsx": "^4.19.0",
    "typescript": "^5",
    "vitest": "^3.2.7"
  }
}
